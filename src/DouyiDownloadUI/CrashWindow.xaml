<Window x:Class="DouyiDownloadUI.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="⚠" FontSize="36" HorizontalAlignment="Center"/>
        <TextBlock Text="软件遇到问题，日志已保存" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock Text="日志位置：" Margin="0,14,0,0" Foreground="#666"/>
        <TextBlock x:Name="LogPathText" Margin="0,4,0,0" Foreground="#666"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="打开日志文件夹" Padding="14,6" Margin="0,0,10,0"
                    Background="#4C8DFF" Foreground="White" Click="OpenLogs_Click"/>
            <Button Content="关闭" Padding="14,6" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
